DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1
# Optional shared classroom access code. Set for a public deployment to protect paid AI calls.
SITE_ACCESS_CODE=
# Generate a stable random value for production. Must be at least 32 characters.
SESSION_SECRET=
# Exact HTTPS origins, comma separated. Set when adding your own production domain.
# The existing https://rightstart.zh-cn.edgeone.cool is already explicitly trusted.
RIGHTSTART_ALLOWED_ORIGINS=
# Optional 32+ character admin token for POST /api/health. Never put it in a URL.
HEALTHCHECK_TOKEN=
